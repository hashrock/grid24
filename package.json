{
  "name": "grid24",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "migrate": "wrangler d1 migrations apply grid24-db --local",
    "migrate:remote": "wrangler d1 migrations apply grid24-db --remote",
    "generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@google/genai": "^1.3.0",
    "@hono/inertia": "^0.2.0",
    "@hono/oauth-providers": "^0.8.7",
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/react": "^3.3.0",
    "bezier-js": "^6.1.4",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/bezier-js": "^4.1.3",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.17.0"
  }
}
