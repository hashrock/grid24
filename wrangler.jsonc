{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grid24",
  "main": "./app/server.ts",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  // Route on the hashrock.info zone. The proxied DNS record for grid.hashrock.info
  // is managed in the dashboard; TLS uses the zone's Universal cert (*.hashrock.info).
  "routes": [{ "pattern": "grid.hashrock.info/*", "zone_name": "hashrock.info" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grid24-db",
      "database_id": "785b6f16-68ab-45b0-ae89-637591a67bfe"
    }
  ]
}
